# /volume1/docker/prod/ggeujeok 에 compose.yaml과 함께 .env.prod로 배치합니다.
COMPOSE_PROJECT_NAME=ggeujeok-prod
APP_ENV=production
SITE_URL=https://shnea.kr
# 외부 NPM이 shnea.kr의 HTTPS를 종료하고 이 HTTP 포트로 전달합니다.
HOST_BIND=0.0.0.0
HTTP_PORT=30145
# NAS의 기존 네트워크와 겹치지 않는 끄적 전용 대역
DOCKER_SUBNET=10.250.20.0/24
IMAGE_PREFIX=registry.shnea.kr/ggeujeok
IMAGE_TAG=
POSTGRES_DB=ggeujeok
POSTGRES_USER=ggeujeok
POSTGRES_PASSWORD=
# 운영 호스트의 영속 데이터 경로. 기존 DB 이전을 완료한 뒤 기동합니다.
DB_DATA_PATH=/volume2/homes/ggeujeok/db
UPLOAD_DATA_PATH=/volume2/homes/ggeujeok/uploads
PLATFORM_URL=https://platform.shnea.kr
PLATFORM_PROJECT_ID=
PLATFORM_ENVIRONMENT_ID=
PLATFORM_API_KEY=
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=app
PLATFORM_OIDC_REDIRECT_URI=https://shnea.kr/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://shnea.kr/
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_SUBJECT=
PLATFORM_WORKER_API_KEY=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_TOKEN=
AI_CALLBACK_TOKEN=

# 광고: 관리 화면에서 서비스·발급값·스위치 저장 가능. 저장값이 환경 기본값보다 우선.
# 애드핏 발급값은 관리 화면에서 입력. 아래 계정·슬롯은 AdSense 초기값.
# 승인·정책/CMP 설정 후 활성화. 슬롯 미입력 시 해당 실광고 생략.
ADS_PROVIDER=adsense
ADS_ENABLED=false
# 실광고를 끈 상태에서 광고 자리 표시 (외부 광고 요청 없음)
ADS_SHOW_PLACEHOLDERS=false
ADSENSE_CLIENT_ID=
ADSENSE_POST_SLOT=
ADSENSE_SIDEBAR_SLOT=
ADSENSE_INLINE_SLOT=
