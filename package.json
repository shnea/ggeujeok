{
  "name": "ggeujeok",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @ggeujeok/api",
    "dev:api": "npm run dev --workspace @ggeujeok/api",
    "dev:web": "npm run dev --workspace @ggeujeok/web",
    "db:migrate": "npm run db:migrate --workspace @ggeujeok/api"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
